          "name": "Search accommodation",
          "request": {
            "name": "Search accommodation",
            "description": {
              "content": "Searches for accommodation by location (latitude/longitude plus radius) or a specific accommodation, with check-in/check-out dates, guests, and rooms. Returns a list of search results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stays",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The version of the Duffel API to use for this request.",
                "key": "Duffel-Version",
                "value": "v2"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"check_in_date\": \"<date>\",\n    \"check_out_date\": \"<date>\",\n    \"rooms\": \"<integer>\",\n    \"guests\": [\n      \"<object>\",\n      \"<object>\"\n    ],\n    \"location\": {\n      \"radius\": \"<integer>\",\n      \"geographic_coordinates\": {\n        \"latitude\": \"<number>\",\n        \"longitude\": \"<number>\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
