      "item": [
        {
          "id": "f93fd59e-adc6-4ad2-8b0a-bfc233558aa9",
          "name": "Create an offer request",
          "request": {
            "name": "Create an offer request",
            "description": {
              "content": "Searches for flights. Provide the slices, passengers, and an optional cabin class; Duffel queries airlines and returns matching offers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "air",
                "offer_requests"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "return_offers",
                  "value": "true"
                },
                {
                  "disabled": false,
                  "key": "supplier_timeout",
                  "value": "20000"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The version of the Duffel API to use for this request.",
                "key": "Duffel-Version",
                "value": "v2"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"slices\": [\n      {\n        \"origin\": \"<string>\",\n        \"destination\": \"<string>\",\n        \"departure_date\": \"<date>\"\n      },\n      {\n        \"origin\": \"<string>\",\n        \"destination\": \"<string>\",\n        \"departure_date\": \"<date>\"\n      }\n    ],\n    \"passengers\": [\n      {\n        \"type\": \"<string>\",\n        \"age\": \"<integer>\"\n      },\n      {\n        \"type\": \"<string>\",\n        \"age\": \"<integer>\"\n      }\n    ],\n    \"cabin_class\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "3b7b410c-09f1-4199-b0fc-55f63f73e484",
              "name": "The offer request was created with offers.",
