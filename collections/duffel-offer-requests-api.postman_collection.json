                  "raw": "{\n  \"data\": {\n    \"slices\": [\n      {\n        \"origin\": \"LHR\",\n        \"destination\": \"JFK\",\n        \"departure_date\": \"2026-07-21\"\n      },\n      {\n        \"origin\": \"LHR\",\n        \"destination\": \"JFK\",\n        \"departure_date\": \"2026-07-21\"\n      }\n    ],\n    \"passengers\": [\n      {\n        \"type\": \"<string>\",\n        \"age\": \"<integer>\"\n      },\n      {\n        \"type\": \"<string>\",\n        \"age\": \"<integer>\"\n      }\n    ],\n    \"cabin_class\": \"<string>\"\n  }\n}",
