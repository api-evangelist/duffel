  "info": {
    "_postman_id": "9676ba09-dd7f-40ba-a705-4b63b3adb75d",
    "name": "Duffel Ancillaries Offer Requests API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Duffel API is a REST API to sell travel - flights, accommodation (Stays), and ancillaries. It covers offer requests and offers, orders, payments, seat maps, ancillary services, accommodation search and booking, and webhooks. Requests are authenticated with a Bearer access token and must include a Duffel-Version header identifying the API version.\n\nContact Support:\n Name: Duffel Support",
      "type": "text/plain"
    }
  }
