                }
              ],
              "body": "{\n  \"data\": {\n    \"id\": \"orq_0000A3tQSmKyqOrcySrGbo\",\n    \"live_mode\": true,\n    \"cabin_class\": \"string\",\n    \"slices\": [\n      {\n        \"origin\": \"LHR\",\n        \"destination\": \"JFK\",\n        \"departure_date\": \"2026-07-21\"\n      },\n      {\n        \"origin\": \"LHR\",\n        \"destination\": \"JFK\",\n        \"departure_date\": \"2026-07-21\"\n      }\n    ],\n    \"offers\": [\n      {\n        \"id\": \"off_0000A3vUda8dKRtUTwfM01\",\n        \"total_amount\": \"521.79\",\n        \"total_currency\": \"GBP\",\n        \"tax_amount\": \"string\",\n        \"owner\": {\n          \"iata_code\": \"string\",\n          \"name\": \"string\"\n        },\n        \"expires_at\": \"2006-05-30T12:50:35.650Z\"\n      },\n      {\n        \"id\": \"off_0000A3vUda8dKRtUTwfM01\",\n        \"total_amount\": \"521.79\",\n        \"total_currency\": \"GBP\",\n        \"tax_amount\": \"string\",\n        \"owner\": {\n          \"iata_code\": \"string\",\n          \"name\": \"string\"\n        },\n        \"expires_at\": \"1975-12-13T02:51:45.545Z\"\n      }\n    ],\n    \"created_at\": \"1993-11-27T23:45:17.568Z\"\n  }\n}",
              "cookie": [],
