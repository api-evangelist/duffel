{
  "opencollection": "1.0.0",
  "info": {
    "name": "Duffel Ancillaries Offer Requests API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Offer Requests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List offer requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.duffel.com/air/offer_requests",
            "headers": [
              {
                "name": "Duffel-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "after",
                "value": "",
                "type": "query"
              },
              {
                "name": "before",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List offer requests"
        },
        {
          "info": {
            "name": "Create an offer request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.duffel.com/air/offer_requests",
            "headers": [
              {
                "name": "Duffel-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "return_offers",
                "value": "",
                "type": "query"
              },
              {
                "name": "supplier_timeout",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Searches for flights. Provide the slices, passengers, and an optional cabin class; Duffel queries airlines and returns matching offers."
        },
        {
          "info": {
            "name": "Get a single offer request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.duffel.com/air/offer_requests/:id",
            "headers": [
              {
                "name": "Duffel-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a single offer request"
        }
      ]
    }
  ],
  "bundled": true
}