                "type": "query"
              }
            ]
          },
          "docs": "Get a single offer"
        },
        {
          "info": {
            "name": "Update an offer to fetch the latest price",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.duffel.com/air/offers/:id/actions/price",
            "headers": [
              {
                "name": "Duffel-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update an offer to fetch the latest price"
        },
        {
          "info": {
            "name": "Update a single offer passenger",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.duffel.com/air/offers/:offer_id/passengers/:offer_passenger_id",
            "headers": [
              {
                "name": "Duffel-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "offer_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "offer_passenger_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a single offer passenger"
        }
      ]
    }
  ],
  "bundled": true
}