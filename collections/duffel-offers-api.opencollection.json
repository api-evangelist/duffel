          },
          "http": {
            "method": "GET",
            "url": "https://api.duffel.com/air/offers",
            "headers": [
              {
                "name": "Duffel-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "offer_request_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List offers"
        },
        {
          "info": {
            "name": "Get a single offer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.duffel.com/air/offers/:id",
            "headers": [
              {
                "name": "Duffel-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
